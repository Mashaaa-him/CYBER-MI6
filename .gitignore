# --- secrets and local config (never commit; .env.example IS committed) -----
.env
.env.*
!.env.example

# --- databases (events can contain DNS names / IPs: never share or commit) ---
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# --- tooling caches ---------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- packet captures (may contain other people's traffic) ---------------------
*.pcap
*.pcapng

# --- editors and OS ---------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
graphify-out/
