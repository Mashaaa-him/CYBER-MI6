API_KEY=a-long-random-string
DATABASE_PATH=data/cybermi6.db
EVENT_RETENTION_DAYS=7
INGEST_MAX_BATCH=100
INGEST_RATE_LIMIT=300
INGEST_RATE_WINDOW_SECONDS=60
PORT_SCAN_PORTS=20
PORT_SCAN_WINDOW_SECONDS=30
DNS_MAX_LABEL_LENGTH=40
DNS_MIN_ENTROPY=3.8
AUTH_FAIL_COUNT=5
AUTH_FAIL_WINDOW_SECONDS=300
ALERT_COOLDOWN_SECONDS=300
ALLOWED_ORIGINS=
# Web path rule. Leave empty to use built-in patterns.
WEB_PATH_PATTERNS_FILE=
# Comma-separated categories to switch off, e.g. admin_panel_probe,xss
WEB_PATH_DISABLED=